[Unit]
Description=Property Studio automatic domain HTTPS provisioning
After=network-online.target mysql.service apache2.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/brijvas-saas
ExecStart=/var/www/brijvas-saas/.venv/bin/python manage.py provision_domains
TimeoutStartSec=1200
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/apache2/sites-available /etc/apache2/sites-enabled /etc/letsencrypt /etc/property-studio /var/lib/letsencrypt /var/log/letsencrypt /var/www/brijvas-saas/acme /run
